# OpenAI
OPENAI_API_KEY=sk-...your_openai_key_here
OPENAI_MODEL=gpt-4o

# Database (optional if using OpenAPI schema source)
DB_CONNECTION_STRING=postgresql://user:password@localhost:5432/college_db

# Pipeline config
MAX_RETRIES=3
SCHEMA_CACHE_TTL_SECONDS=3600
LOG_LEVEL=INFO

# Agent 5 — SQL Executor
EXECUTOR_MAX_ROWS=500      # max rows returned per query (hard cap)
